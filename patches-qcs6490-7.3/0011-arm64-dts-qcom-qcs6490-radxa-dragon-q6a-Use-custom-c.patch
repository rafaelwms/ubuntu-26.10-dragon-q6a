From f898efeeb0fdfb4e8a12927b50f7bb48619711ea Mon Sep 17 00:00:00 2001
From: Q6A port <port@local>
Date: Sat, 31 Oct 2026 12:58:24 -0300
Subject: [PATCH 11/13] arm64: dts: qcom: qcs6490-radxa-dragon-q6a: Use custom
 cdsp firmware

---
 arch/arm64/boot/dts/qcom/qcs6490-radxa-dragon-q6a.dts      | 2 +-
 arch/arm64/boot/dts/qcom/qcs6490-radxa-dragon-q6a.dts.orig | 6 ------
 2 files changed, 1 insertion(+), 7 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/qcs6490-radxa-dragon-q6a.dts b/arch/arm64/boot/dts/qcom/qcs6490-radxa-dragon-q6a.dts
index eca7eaae0..11f6af307 100644
--- a/arch/arm64/boot/dts/qcom/qcs6490-radxa-dragon-q6a.dts
+++ b/arch/arm64/boot/dts/qcom/qcs6490-radxa-dragon-q6a.dts
@@ -791,7 +791,7 @@ &remoteproc_adsp {
 };
 
 &remoteproc_cdsp {
-	firmware-name = "qcom/qcs6490/cdsp.mbn";
+	firmware-name = "qcom/qcs6490/radxa/dragon-q6a/cdsp.mbn";
 	status = "okay";
 };
 
diff --git a/arch/arm64/boot/dts/qcom/qcs6490-radxa-dragon-q6a.dts.orig b/arch/arm64/boot/dts/qcom/qcs6490-radxa-dragon-q6a.dts.orig
index a5ba62d87..eca7eaae0 100644
--- a/arch/arm64/boot/dts/qcom/qcs6490-radxa-dragon-q6a.dts.orig
+++ b/arch/arm64/boot/dts/qcom/qcs6490-radxa-dragon-q6a.dts.orig
@@ -573,11 +573,6 @@
 	/delete-property/ memory-region;
 };
 
-/* It takes a long time in ufshcd_init_crypto when enabled */
-&ice {
-	status = "disabled";
-};
-
 &lpass_audiocc {
 	compatible = "qcom,qcm6490-lpassaudiocc";
 	/delete-property/ power-domains;
@@ -1080,7 +1075,6 @@
 	/* Gear-4 Rate-B is unstable due to board */
 	/* and UFS module design limitations */
 	limit-gear-rate = "rate-a";
-	/delete-property/ qcom,ice;
 
 	status = "okay";
 };
-- 
2.53.0

